/target
Cargo.lock

# Local build artifacts (optional)
.build/
# docker buildx bake type=local cache (scripts/docker/bake-images.sh)
docker/.buildx-cache/

# Local runtime / cache (trace sink JSONL, Iceberg warehouse, etc.) — not for VCS
var/

# fastembed / Qdrant ONNX model cache (downloaded at runtime; never commit)
.fastembed_cache/

# Profiling output (dhat, etc.) — never commit
dhat-heap.json
# insta scratch (accepted snapshots are committed as *.snap only)
*.pending-snap
.*.pending-snap
*.snap.new

# Python bytecode
__pycache__/
*.pyc
*.swp
*.swo
*~
.DS_Store
.env
# Local plasm dev JWT (scripts/ensure-plasm-dev-jwt-secret.sh)
.plasm/
# Local Cursor + plasm helper script artifacts (see scripts/cursor-plasm-mcp.sh)
.cursor/plasm.log
.cursor/plasm.pid
.cursor/plasm-goal.md
# Eval BAML clients: regenerate via `baml-cli generate` from monorepo root (see scripts/ci/ensure-baml-codegen.sh).
/crates/plasm-eval/baml_client
/crates/plasm-discovery-eval/baml_client
eval-reports/
# plasm-eval last-run artifacts next to cases.yaml ({model-slug}.latest.*)
apis/**/eval/*.latest.human.txt
apis/**/eval/*.latest.json
fixtures/**/eval/*.latest.human.txt
fixtures/**/eval/*.latest.json

# Large GitHub REST OpenAPI bundle (curl from github/rest-api-description; see apis/github/README.md)
fixtures/real_openapi_specs/github_api_github_com.json

# Accidental pack-plugin cache trees at repo root (wrong cwd)
90362_pd/

# Local app bundles / scratch downloads at repo root (never commit)
/Contents-1/
/Contents/
/MapTool-*.zip
/mcp-server-guide*.zip
/episode-*.txt
/vke-*.yaml

# Local Infisical/K8s secret exports (may contain live material)
/infisical-k8s-export-*/

# Local installers (GitHub rejects >100MB; keep out of VCS)
*.dmg
# Local MCP keys at repo root
plasm-mcp.*.pem

# Accidental nested tree (wrong `cwd` / duplicate checkout). Real layout is `./crates/...`;
# a second `plasm-oss/` here is not a package — insta may drop `*.pending-snap` under it for inline snapshots.
/plasm-oss/

{
  "name": "@plasm_lang/engine",
  "version": "0.3.106",
  "description": "NAPI bindings for the Plasm catalog-native agent engine",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PlasmTools/plasm-core.git",
    "directory": "packages/plasm-engine"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "napi.json",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md"
  ],
  "scripts": {
    "build": "napi build --platform --release --manifest-path ../../crates/plasm-node/Cargo.toml -p plasm-node -o .",
    "build:debug": "napi build --manifest-path ../../crates/plasm-node/Cargo.toml -p plasm-node -o .",
    "artifacts": "napi artifacts --manifest-path ../../crates/plasm-node/Cargo.toml -p plasm-node",
    "create-npm-dirs": "napi create-npm-dirs",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release --skip-optional-publish"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}

load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_test(
    name = "unit_tests",
    crate = ":plasm_evidence",
    compile_data = ["//:test_fixtures", "//:agent_prompt_assets"],
    data = ["Cargo.toml", "//:test_fixtures", "//:agent_prompt_assets"] + glob(["src/**/*.snap", "src/**/*.rs", "tests/support/**", "migrations/**"], allow_empty = True),
    env = {"INSTA_WORKSPACE_ROOT": "."},
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "plasm_evidence",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["signatures"],
    crate_root = "src/lib.rs",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = "0.5.5",
    visibility = ["//visibility:public"],
    deps = ["//crates/plasm-core:plasm_core"] + all_crate_deps(normal = True),
)

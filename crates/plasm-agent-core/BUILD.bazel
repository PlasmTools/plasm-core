load("//build/bazel:integration_tests.bzl", "rust_integration_tests")
load(":build_targets.bzl", "build_targets")
load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")

build_targets()

# Offline diagnostic adapter: production request encoding and response decoding.
rust_binary(
    name = "classification_probe",
    srcs = ["examples/classification_probe.rs"],
    crate_root = "examples/classification_probe.rs",
    edition = "2021",
    aliases = aliases(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [":plasm_agent_core"] + all_crate_deps(normal = True),
)

# Native serialization proof consumed by the TypeScript routing tests.
rust_binary(
    name = "routing_contract",
    srcs = ["examples/routing_contract.rs"],
    crate_root = "examples/routing_contract.rs",
    compile_data = ["//:test_fixtures"],
    edition = "2021",
    aliases = aliases(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [":plasm_agent_core"] + all_crate_deps(normal = True),
)

filegroup(
    name = "embedded_ui_assets",
    srcs = glob(["src/assets/**"]),
    visibility = ["//visibility:public"],
)

exports_files(["tests/support/postgres.rs"])

filegroup(
    name = "test_fixtures",
    srcs = glob(["tests/fixtures/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "integration_support",
    srcs = glob(["tests/support/**"]),
    visibility = ["//visibility:public"],
)

rust_integration_tests(
    compile_data = [
        "//:test_fixtures",
        "//:language_reference",
        "//:agent_prompt_assets",
    ] + glob(
        [
            "src/**",
            "migrations/**",
        ],
        allow_empty = True,
    ),
    data = [
        "//:agent_prompt_assets",
        "//:catalog_sources",
        "//:language_reference",
        "//:test_fixtures",
    ] + glob(
        ["migrations/**"],
        allow_empty = True,
    ),
    tests = {
        "binding_store": "tests/binding_store.rs",
        "concurrent_mcp_plasm": "tests/concurrent_mcp_plasm.rs",
        "cross_pod_operations": "tests/cross_pod_operations.rs",
        "evidence_http": "tests/evidence_http.rs",
        "flow_policy_golden_scenarios": "tests/flow_policy_golden_scenarios.rs",
        "flow_policy_simulate_http_contract": "tests/flow_policy_simulate_http_contract.rs",
        "flow_policy_simulate_scenarios": "tests/flow_policy_simulate_scenarios.rs",
        "http_terminal_protocol": "tests/http_terminal_protocol.rs",
        "incoming_auth_device_http": "tests/incoming_auth_device_http.rs",
        "long_operation_http": "tests/long_operation_http.rs",
        "mcp_config_admin": "tests/mcp_config_admin.rs",
        "mcp_python_protocol": "tests/mcp_python_protocol.rs",
        "mcp_readiness_pending_auth": "tests/mcp_readiness_pending_auth.rs",
        "mcp_standalone_sse_reconnect": "tests/mcp_standalone_sse_reconnect.rs",
        "operation_lifecycle": "tests/operation_lifecycle.rs",
        "python_compute_feasibility": "tests/python_compute_feasibility.rs",
        "run_ui_progress_http": "tests/run_ui_progress_http.rs",
    },
    deps = [
        "//crates/plasm-agent-core:plasm_agent_core",
        "//crates/plasm-catalog:plasm_catalog",
        "//crates/plasm-compile:plasm_compile",
        "//crates/plasm-core:plasm_core",
        "//crates/plasm-evidence:plasm_evidence",
        "//crates/plasm-otel:plasm_otel_testing",
        "//crates/plasm-runtime:plasm_runtime",
        "//crates/plasm-trace:plasm_trace",
        "//crates/plasm-trace-wire:plasm_trace_wire",
    ],
)
